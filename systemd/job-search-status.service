[Unit]
Description=Job Search - Send daily status digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/mihir965/Documents/Developer/job_search
ExecStart=/home/mihir965/Documents/Developer/job_search/venv/bin/python -m src.main status --notify
EnvironmentFile=-/home/mihir965/.config/job-search/env
StandardOutput=journal
StandardError=journal
