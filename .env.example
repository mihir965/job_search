# Job Outreach Automation - Environment Variables
# Copy this file to .env and fill in your actual values

# ── SMTP (Gmail) - REQUIRED for sending emails ──
SMTP_USER=mihir.atul.kulkarni@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# ── API Keys (all optional) ──

# Anthropic API (for LLM email personalization)
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# Hunter.io API (for finding emails - 25 free/month)
# Get it from: https://hunter.io/
HUNTER_API_KEY=your_hunter_key_here

# Apollo.io API (for finding emails - 50 free/month)
# Get it from: https://www.apollo.io/
APOLLO_API_KEY=your_apollo_key_here
